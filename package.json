{
  "name": "anneal",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bash scripts/run-scope-guard.sh build && npm run build -w @anneal/github-client && npm run build -w @anneal/db && npm run build -w @anneal/api && npm run build -w @anneal/runner && npm run build -w @anneal/inbox && npm run build -w @anneal/merge-executor && npm run build -w @anneal/web",
    "typecheck": "bash scripts/run-scope-guard.sh typecheck && npm run typecheck --workspaces --if-present",
    "typecheck:cli": "npm run typecheck:cli -w @anneal/db",
    "lint": "bash scripts/run-scope-guard.sh lint && npm run lint:biome && npm run lint:types",
    "lint:biome": "bash scripts/run-scope-guard.sh lint:biome && biome lint",
    "lint:types": "bash scripts/run-scope-guard.sh lint:types && eslint .",
    "test": "bash scripts/run-scope-guard.sh test && npm run test --workspaces --if-present",
    "setup:local": "node scripts/setup-local.mjs",
    "test:setup-local": "node --test scripts/setup-local.test.mjs",
    "verify:secret-hygiene": "node scripts/verify-secret-hygiene.mjs",
    "test:secret-hygiene": "node --test scripts/verify-secret-hygiene.test.mjs",
    "test:merge-executor-setup": "node --test scripts/setup-merge-executor.test.mjs",
    "verify:compose-binding": "node scripts/compose-binding.mjs",
    "test:compose-binding": "node --test scripts/compose-binding.test.mjs",
    "test:frozen-docs": "node --test scripts/check-frozen-docs.test.mjs",
    "test:operator-api-docs": "node --test scripts/operator-api-docs.test.mjs",
    "test:gate-worker": "node --test scripts/gate-worker/gate-env.test.mjs scripts/gate-worker/gate-worker.test.mjs scripts/gate-worker/gate-dispatch.test.mjs scripts/merge-lease.test.mjs scripts/merge-train.test.mjs",
    "test:run-scope-guard": "node --import tsx --test scripts/run-scope-guard.test.mjs",
    "test:host-proof-slot": "node --test scripts/host-proof-slot.test.mjs",
    "test:merge-train": "node --test scripts/merge-train.test.mjs",
    "test:auto-deploy": "node --test scripts/deploy/quiet-window-backup.test.mjs scripts/deploy/quiet-window-command.test.mjs scripts/deploy/quiet-window-deadlines.test.mjs scripts/deploy/quiet-window-deploy.test.mjs scripts/deploy/quiet-window-escalation.test.mjs scripts/deploy/remote-main-read.test.mjs scripts/deploy/launchd-service-wrapper.test.mjs scripts/deploy/service-control.test.mjs scripts/deploy/service-inventory.test.mjs scripts/deploy/systemd-installer.test.mjs scripts/deploy/release-directory.test.mjs scripts/deploy/release-pointer.test.mjs scripts/deploy/release-snapshot.test.mjs scripts/os-isolation/os-isolation.test.mjs",
    "snapshot:scan": "node scripts/public-snapshot-scan.mjs",
    "test:snapshot-scan": "node --test scripts/public-snapshot-scan.test.mjs",
    "test:release-docs": "node --test scripts/release-docs.test.mjs scripts/setup-merge-executor.test.mjs",
    "demo:templates": "node scripts/templates-release-demo.mjs",
    "test:demo-templates": "node --test scripts/templates-release-demo.test.mjs",
    "test:dependency-gate": "node --test scripts/goal-5a0-dependency-gate.test.mjs scripts/goal-5a0-handoff-preimage.test.mjs",
    "test:db": "bash scripts/run-scope-guard.sh test:db && npm run test:db -w @anneal/api",
    "merge-gate": "bash scripts/run-scope-guard.sh merge-gate && bash scripts/merge-gate.sh",
    "verify:build-sha": "node packages/build-info/verify-dist.mjs",
    "dev:api": "npm run dev -w @anneal/api",
    "dev:web": "npm run dev -w @anneal/web",
    "dev:runner": "npm run dev -w @anneal/runner",
    "dev:inbox": "npm run dev -w @anneal/inbox",
    "db:generate": "npm run db:generate -w @anneal/db",
    "db:migrate": "npm run db:migrate -w @anneal/db",
    "db:migrate:release": "npm run db:migrate:release -w @anneal/db --",
    "db:migrate-status": "npm run db:migrate-status -w @anneal/db",
    "db:drift-check": "npm run db:drift-check -w @anneal/db",
    "db:seed": "npm run db:seed -w @anneal/db",
    "db:sync-canonical-prompts": "npm run db:sync-canonical-prompts -w @anneal/db --",
    "db:template-digest": "npm run db:template-digest -w @anneal/db",
    "db:verify-agent-template": "npm run db:verify-agent-template -w @anneal/db --",
    "db:validate": "npm run db:validate -w @anneal/db",
    "db:preflight-goal-execution": "npm run db:preflight-goal-execution -w @anneal/db",
    "db:files-precheck": "npm run db:files-precheck -w @anneal/db",
    "db:migrate-goal-execution": "npm run db:migrate-goal-execution -w @anneal/db",
    "db:verify-goal-execution": "npm run db:verify-goal-execution -w @anneal/db",
    "db:verify-starter-onboarding": "npm run db:verify-starter-onboarding -w @anneal/db",
    "db:export-goal-lineage": "npm run db:export-goal-lineage -w @anneal/db",
    "db:backfill-session-usage": "npm run db:backfill-session-usage -w @anneal/db",
    "db:backfill-session-cache": "npm run db:backfill-session-cache -w @anneal/db",
    "db:backfill-merge-stop-questions": "npm run db:backfill-merge-stop-questions -w @anneal/db",
    "db:audit-post-delivery-disconnect": "npm run db:audit-post-delivery-disconnect -w @anneal/db",
    "db:backfill-task-source": "npm run db:backfill-task-source -w @anneal/db",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "eslint": "10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true
  }
}
