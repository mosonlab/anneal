node_modules/
dist/
# The merge gate's worktree lock, and the two names lib.sh's slot lock stages
# and reclaims through. They are taken before the gate checks that the worktree
# is clean, so an unignored one would fail every gate.
/.merge-gate.slot
/.staged..merge-gate.*
/.reclaim..merge-gate.*
.agentos-deploy/
/releases/
/shared/
/current
/previous
.agentos-pi/
.env
# Human-captured merge-executor service input. It contains the executor API
# bearer and is installed separately from the repository configuration.
.merge-executor.env
.merge-executor.env.tmp.*
# `npm run setup:local` writes the complete bytes of an unpublished .env to a
# same-directory temporary file before it links them into place. An interrupted
# run leaves one behind, holding every generated credential.
.env.setup-local.*
.DS_Store
*.log
packages/db/generated/
