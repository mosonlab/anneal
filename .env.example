# PostgreSQL started by docker-compose.yml
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=CHANGE_ME
# The target schema is named explicitly: the release preflight stops on a URL
# that does not say which schema it is about.
DATABASE_URL=postgresql://agentos:CHANGE_ME@127.0.0.1:5432/agentos?schema=public

# Control-plane API. These principals must be distinct random values.
# `npm run setup:local` generates a complete .env; this file documents the keys
# and is not a file to copy.
#
# The API validates all of this before it acquires ownership, opens the database
# or binds a socket (packages/api/src/startup-config.ts): a missing, placeholder
# or shared principal token, a malformed encryption key, a placeholder or
# self-inconsistent database configuration, or an API_HOST other than the
# loopback literal is a refusal to start, not a warning.
#
# Two details worth knowing before deleting a line here. The encryption key is
# parsed as strict base64 — Node's decoder ignores illegal characters, so a key
# it would accept is not necessarily one this repository will. And leaving the
# POSTGRES_* above unset is not leaving them absent: docker-compose.yml reads
# them as ${POSTGRES_DB:-agentos} and starts the database with those defaults,
# so DATABASE_URL is compared against what Compose will actually use.
API_HOST=127.0.0.1
API_PORT=3000
OPERATOR_TOKEN=CHANGE_ME
RUNNER_TOKEN=CHANGE_ME
SESSION_COOKIE_SECRET=CHANGE_ME
# 32 random bytes encoded as base64; stays outside the database and runner env.
AGENTOS_SECRET_ENCRYPTION_KEY=CHANGE_ME

# Browser console. No token is compiled into or stored by the browser: the web
# dev/preview server proxies /api to the control plane and attaches OPERATOR_TOKEN
# in its own process (apps/web/vite.config.ts). There is deliberately no VITE_*
# credential, and a VITE_*TOKEN* key anywhere in this file is a startup refusal.
#
# WEB_API_URL and RUNNER_API_URL share one Developer Preview policy: the only
# accepted destination is the exact numeric loopback HTTP origin
# `http://127.0.0.1:<port>` — no `localhost`, no other 127/8 spelling, no IPv6,
# no HTTPS, and no userinfo, path, query or fragment. Both the Vite proxy and the
# runner refuse anything else before they create a client or attach a bearer
# header. The accepted and rejected forms are enumerated in
# scripts/fixtures/local-api-origin-cases.json.
WEB_API_URL=http://127.0.0.1:3000

# Local runner process: runner principal only.
RUNNER_API_URL=http://127.0.0.1:3000
RUNNER_POLL_INTERVAL_MS=5000
# Claims are deferred while the host's 1-minute load average is strictly above
# this threshold. The default is CPU count * 1.5; an override must be a
# positive finite integer or decimal. Node reports zero load on Windows, so
# this admission check is a no-op there.
# RUNNER_CLAIM_MAX_LOAD_AVERAGE=
# Optional comma-separated list of exact RunnerKind names served by this host.
# When unset, the runner serves every kind. Invalid values refuse daemon startup.
# RUNNER_SERVED_KINDS=
RUNNER_LEASE_SECONDS=60
RUNNER_HEARTBEAT_INTERVAL_MS=30000
# Set this explicitly on any host that should reclaim its own workspaces across a
# restart. It is the *only* thing that authorises a workspace removal (issue
# #115): the control plane offers a directory when `Run.runnerId` equals the
# caller, and nothing else. The default is `<hostname>-<pid>`, which changes on
# every restart, so a restarted runner leaves its earlier directories behind as
# open intents that never close. Leaking is the intended failure direction —
# adopting another identity's workspaces is not.
RUNNER_ID=

# Optional operator-owned SSH gate worker used by the canonical Direct and Full
# Assurance regression steps. setup:local does not create a worker or set this
# value. Provision one with docs/runbooks/gate-worker.md, then name the safe SSH
# destination here; the runner pins it over task-supplied secrets. With the
# fallback below, this primary destination provides two remote slots.
# RUNNER_GATE_SERVER=gate-worker.example
# Optional second SSH gate worker. Requires RUNNER_GATE_SERVER and must name a
# different destination; sessions try the two primary slots before one fallback
# slot. The runner pins both destinations over task-supplied secrets.
# RUNNER_GATE_FALLBACK_SERVER=gate-worker-fallback.example
# Optional local gate capacity for this runner. Set a positive integer to let
# canonical regression steps use that many explicitly enabled local slots
# before the configured remote worker; leave unset to keep local dispatch off.
# RUNNER_GATE_LOCAL_SLOTS=2

# Optional child-process PATH override. Defaults to
# /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin on macOS and
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin on Linux.
# RUNNER_PATH=/operator/managed/bin:/usr/bin:/bin
# Optional human Git identity override. Set both or neither. When omitted, the
# runner reads user.name and user.email from the runner account's global config
# and pins them into every run repository as local config.
# RUNNER_GIT_USER_NAME=
# RUNNER_GIT_USER_EMAIL=
# The home the runner hands to a model CLI. Defaults to the runner process
# owner's own HOME; set it only when the CLIs run as a separate account (see
# RUNNER_RUN_AS_PREFIX below). Leave it unset rather than empty — an empty value
# is not the default, it is an empty home.
# RUNNER_HOME=/opt/agentos/accounts/agentos1
# Persistent bare mirrors used by runner provisioning and claim-side pinned-spec
# verification. In OS-isolated deployments, the API and its run-as principal
# must point at the same runner-owned directory.
# RUNNER_REPO_MIRROR_ROOT=/opt/agentos/accounts/agentos1/.agentos/repo-mirrors
# Default: the runner process owner's ~/.agentos/runs. Values are not shell-expanded,
# so an override must be an absolute path (for example: /opt/agentos/runs).
# RUNNER_WORKSPACE_ROOT=/opt/agentos/runs
# API-only ownership state. This must be a disjoint local filesystem directory,
# mode 0700, owned by the API uid, and unreadable/unwritable by runner/model uids.
# CONTROL_PLANE_STATE_DIR=/opt/agentos/control-plane
RUNNER_FAILED_WORKSPACE_RETENTION=2
# How often the runner asks the control plane which of its own workspace
# directories may be reclaimed (issue #115: the API publishes the intent, the
# runner does the deleting). Not on the hot path — a run's own workspace is
# removed inline when it ends; this only collects what a crash left behind.
RUNNER_WORKSPACE_RECLAIM_INTERVAL_MS=300000
# Maximum time without trusted structured progress from one in-flight tool.
RUNNER_TOOL_DEADLINE_MS=1800000

# Optional low-privilege launch prefix. Leave empty unless the account exists,
# can traverse RUNNER_WORKSPACE_ROOT, and all three CLIs are logged in for that account.
# The default workspace root is still resolved under the runner process owner's home;
# point it elsewhere or grant the launched account traversal explicitly. No ACLs are managed.
# While this prefix is empty, model CLIs run as the runner's OS user and FilesystemGrant
# is an audit/ergonomics boundary, not a security boundary.
# The scripts that provision, verify, patch and roll back the accounts are in
# scripts/os-isolation/; each carries its own contract in its header. What this
# prefix does and does not isolate: docs/release/security.md.
RUNNER_RUN_AS_PREFIX=
# Example after those prerequisites: sudo -u _agentos1 -E --
# The -E is not optional with sudo. env_reset otherwise strips AGENTOS_SESSION_TOKEN,
# AGENTOS_FENCING_TOKEN, AGENTOS_API_URL, RUNNER_PATH, and every injected secret from
# the CLI's environment, and sudo only honours -E when the sudoers rule carries SETENV.

# Where the CLI finds the Anneal MCP server and the pi extension. The CLI spawns these
# itself, as the launched account, so with a run-as prefix they must live outside the
# runner process owner's home (macOS homes are 0700 and not traversable). Defaults point
# inside the runner package; scripts/os-isolation/provision.sh stages readable copies.
# RUNNER_MCP_SERVER_PATH=/opt/agentos/lib/mcp-server.js
# RUNNER_PI_EXTENSION_PATH=/opt/agentos/lib/pi-agentos-extension.ts
# RUNNER_CLAUDE_SETTINGS_PATH=/opt/agentos/lib/claude-platform-settings.json
# RUNNER_SESSION_CONFIG_BASELINE_ROOT=/opt/agentos/lib/session-config-baseline
# The interpreter the CLI is told to run that MCP server with. Defaults to the runner's
# own process.execPath, which is a *resolved* path (a Homebrew Cellar or version-manager
# directory), not the symlink on RUNNER_PATH — under a run-as prefix the launched account
# may not be able to traverse it, and the failure appears as an MCP error inside the agent
# session rather than as a deployment error. Set this to an interpreter both principals can
# execute; the runner refuses to start if it is set to something it cannot execute, and
# prints whichever one is in force in its {"runtime":"agentos-runner",...} startup line.
# RUNNER_NODE_BINARY=/opt/agentos/bin/node

# Optional platform-owned proxy for the whole runner-controlled network path:
# Claude, Codex, Pi, and the Git/workspace commands that provision and deliver
# their work. All three are unset by default, so an open-source installation
# does not use a proxy. Configure them only in the installation's private .env;
# they remain available even though provider user settings are deliberately
# excluded. Conventional HTTP_PROXY / HTTPS_PROXY / NO_PROXY variables are not
# inherited. If RUNNER_RUN_AS_PREFIX is set, that launcher must preserve this
# environment (the shipped sudo example uses -E); proxy URLs are never copied
# into provider argv because they may contain credentials.
# RUNNER_HTTP_PROXY=http://127.0.0.1:7897
# RUNNER_HTTPS_PROXY=http://127.0.0.1:7897
# RUNNER_NO_PROXY=127.0.0.1,localhost

CLAUDE_BINARY=claude
CODEX_BINARY=codex
PI_BINARY=pi

# Feishu Inbox long connection. Keep the service resident: missed events are not replayed.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEFAULT_CHAT_ID=
INBOX_DELIVERY_POLL_MS=2000
# Set to 0 to disable CRON/AT polling without changing API behavior.
SCHEDULER_POLL_INTERVAL_MS=30000

# Files Root defaults to the API process owner's ~/Documents/agentos. Values are not
# shell-expanded, so overrides must be absolute (for example: /opt/agentos/files).
# FILES_ROOT=/opt/agentos/files
# With iCloud Desktop & Documents sync, files can become dataless placeholders: reads
# may fail and agent writes may be uploaded. The API warns at startup but still starts.
# FilesystemGrant becomes a security boundary only when the model CLI runs as a separate
# principal that cannot traverse or write FILES_ROOT; otherwise it is an audit boundary.
# FILES_ROOT must not overlap RUNNER_WORKSPACE_ROOT in either direction: agents can write
# anywhere in a run workspace, and write access inside the Files Root is the precondition
# for the post-walk directory swap the store cannot close. The API refuses to start on
# overlap, and warns while RUNNER_RUN_AS_PREFIX is empty (the shipped default), because
# that is exactly the configuration in which the backstop for that gap is absent.

# --- Merge Integrator v1.1 (issue #100) --------------------------------------
# Every value below is empty by default and every default is fail-closed: an
# unconfigured deployment produces no merge authorization and claims no
# integrator run, rather than merging with weaker guarantees.

# API process. The runner ids permitted to claim integrator runs (Full Assurance
# step 12 or Direct step 7) — and permitted to claim nothing else. Empty means
# no integrator run is ever claimable by anyone, including the merge executor.
MERGE_EXECUTOR_RUNNER_IDS=

# Required API credential. The API refuses startup with exit 78 and a
# `missing:GITHUB_READ_TOKEN` or `placeholder-value:GITHUB_READ_TOKEN` reason
# when this is not configured. It is read-only and fills
# the merge-readiness approval card (Full Assurance step 11 or Direct step 6)
# with the live head SHA, base SHA, and required-check
# conclusions BEFORE the human answers. It never merges and is a different
# credential from the merge token; the two are never exchanged.
GITHUB_READ_TOKEN=CHANGE_ME
# Bounded, cancellable evidence read (§D-P3): the GitHub call happens outside
# every transaction, under one AbortController, with bounded retries.
MERGE_EVIDENCE_READ_TIMEOUT_MS=8000
MERGE_EVIDENCE_ATTEMPTS=3
# How long a placeholder card is withheld from the Inbox outbox while the worker
# fills it, so a human is never shown an empty approval card.
EVIDENCE_DEADLINE_MS=60000

# --- @anneal/merge-executor -------------------------------------------------
# Provisioning, the installation-local private GitHub App permission contract,
# supported macOS LaunchDaemon/Linux systemd profiles, verification, rotation,
# and recovery are authoritative in docs/runbooks/merge-executor.md. Run
# scripts/setup-merge-executor.sh after `npm run setup:local`; it preserves
# existing .env assignments unless the human types a replacement and writes a
# separate mode-0600 .merge-executor.env service-install input.
#
# The API consumes MERGE_EXECUTOR_RUNNER_IDS and MERGE_EXECUTOR_TOKEN. The
# executor service consumes the executor-only subset written by the wizard. Do
# not point that service at the whole repository .env: it also contains API,
# runner, database, session, and encryption credentials. Never expose the
# executor subset to a model runner or inbox process. The executor refuses to
# start if its own OS user is also a declared peer user.
#
# GitHub App private-key bytes are NOT an environment variable anywhere, by
# design. A process environment is `ps`- and `launchctl`-readable; the key lives
# only in a non-empty regular owner-only file (at most 64 KiB) owned by the
# executor's uid, on a path with no group- or world-writable directory.
# Standard GitHub token variables and private-key environment variables are
# startup refusals. The public App and
# installation identifiers may be configured here. A fresh installation token
# is minted after every mechanical Run claim and is never cached across Runs.
MERGE_EXECUTOR_GITHUB_APP_ID=
MERGE_EXECUTOR_GITHUB_APP_INSTALLATION_ID=
MERGE_EXECUTOR_GITHUB_APP_PRIVATE_KEY_FILE=
MERGE_EXECUTOR_OS_USER=
MERGE_EXECUTOR_PEER_USERS=
# Must also appear in the API's MERGE_EXECUTOR_RUNNER_IDS, or the claim route
# offers this process nothing.
MERGE_EXECUTOR_RUNNER_ID=
# The configured App bot login (normally `<app-slug>[bot]`), used by the §5.1
# replay determination to tell our own landed merge from someone else's.
MERGE_EXECUTOR_IDENTITY_LOGIN=
MERGE_EXECUTOR_API_URL=http://localhost:3000
# The executor's own bearer (§D-P1 rule 3). It MUST differ from RUNNER_TOKEN and
# OPERATOR_TOKEN: both the API and the executor refuse an aliased value, because
# a shared token would let any runner claim a mechanical run and author the
# `merge-result` the chain trusts. Unset here, so a default deployment
# authenticates no merge executor at all.
MERGE_EXECUTOR_TOKEN=
# Lease, poll and timeout bounds for the executor's own loop. The lease must be
# long enough to cover a bounded mergeability poll plus the merge itself.
MERGE_EXECUTOR_LEASE_SECONDS=120
MERGE_EXECUTOR_POLL_INTERVAL_MS=5000
# Bounds how often a contract-mismatched daemon re-claims.
MERGE_EXECUTOR_CONTRACT_RECHECK_MS=60000
MERGE_EXECUTOR_API_TIMEOUT_MS=15000
MERGE_EXECUTOR_GITHUB_TIMEOUT_MS=15000
# Independent wall-clock bound for private-key acquisition and for the
# installation-token exchange.
MERGE_EXECUTOR_GITHUB_APP_AUTH_TIMEOUT_MS=15000
# GitHub endpoints, overridable for GitHub Enterprise and for the evidence
# harness's scratch fixtures. Defaults are github.com.
GITHUB_REST_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
# The bounded UNKNOWN-mergeability poll (§11.2). On exhaustion the run stops
# `unresolved-mergeability` rather than merging on an unresolved state. The
# budget is the wall-clock ceiling over the whole poll, so a platform that keeps
# answering slowly cannot outlast the lease.
MERGE_EXECUTOR_MERGEABILITY_POLL_ATTEMPTS=5
MERGE_EXECUTOR_MERGEABILITY_POLL_MS=2000
MERGE_EXECUTOR_MERGEABILITY_POLL_BUDGET_MS=

# --- §D-P6 GraphQL schema gate (developer/CI only) ---------------------------
# A read-only token used solely to introspect GitHub's schema and fail on drift
# in any field or enum value the executor binds. Unset skips the gate loudly; it
# is never read by the executor process.
GITHUB_SCHEMA_GATE_TOKEN=
