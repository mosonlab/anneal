generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NetworkingMode {
  OPEN    @map("open")
  LIMITED @map("limited")
}

enum SkillKind {
  PROMPT @map("prompt")
  FILE   @map("file")
}

enum RepoPermission {
  GIT_READ  @map("git-read")
  GIT_WRITE @map("git-write")
}

enum DependencyProvisioning {
  NONE
  NPM_CI
}

enum SecretPurpose {
  MCP     @map("mcp")
  REPO    @map("repo")
  ENV     @map("env")
  WEBHOOK @map("webhook")
}

enum RunnerKind {
  CLAUDE @map("claude")
  CODEX  @map("codex")
  PI     @map("pi")
}

enum RunnerPreference {
  CLAUDE  @map("claude")
  CODEX   @map("codex")
  PI      @map("pi")
  AUTO    @map("auto")
  INHERIT @map("inherit")
}

enum CodexServiceTier {
  DEFAULT @map("default")
  FAST    @map("fast")
}

enum TaskStatus {
  // BACKLOG is first so the datamodel's value order matches the database's:
  // its migration adds the value with `BEFORE 'todo'`.
  BACKLOG @map("backlog")
  TODO    @map("todo")
  DOING   @map("doing")
  REVIEW  @map("review")
  DONE    @map("done")
}

/// How a Task came to exist. The recurring definition itself stays MANUAL;
/// only its fired copies are CRON.
enum TaskSource {
  MANUAL  @map("manual")
  CRON    @map("cron")
  WEBHOOK @map("webhook")
}

enum TriggerFireSource {
  WEBHOOK @map("webhook")
  MANUAL  @map("manual")
}

enum AssigneeType {
  AGENT @map("agent")
  HUMAN @map("human")
}

enum ScheduleKind {
  NOW  @map("once-now")
  AT   @map("at")
  CRON @map("cron")
}

enum GoalStatus {
  ACTIVE        @map("active")
  PAUSED        @map("paused")
  COMPLETED     @map("completed")
  STOPPED_SPEND @map("stopped-spend")
  STOPPED_TIME  @map("stopped-time")
  STOPPED_STUCK @map("stopped-stuck")
  FAILED        @map("failed")
  CANCELLED     @map("cancelled")
}

/// Dispatch state of one Goal iteration's Task. `MIGRATED_CLOSED` is only ever
/// written by the Goal 5a0 backfill for pre-kernel history; runtime code never
/// writes it.
enum GoalDispatchState {
  EXECUTING         @map("executing")
  AWAITING_DECISION @map("awaiting-decision")
  ADVANCED          @map("advanced")
  GOAL_COMPLETED    @map("goal-completed")
  GOAL_FAILED       @map("goal-failed")
  CANCELLED         @map("cancelled")
  MIGRATED_CLOSED   @map("migrated-closed")
}

enum InboxSender {
  AGENT @map("agent")
  HUMAN @map("human")
}

enum InboxKind {
  TEXT            @map("text")
  MULTIPLE_CHOICE @map("multiple-choice")
}

enum InboxStatus {
  OPEN     @map("open")
  ANSWERED @map("answered")
  CLOSED   @map("closed")
}

enum InboxChannel {
  FEISHU @map("feishu")
}

enum InboxDeliveryStatus {
  PENDING   @map("pending")
  SENDING   @map("sending")
  DELIVERED @map("delivered")
  FAILED    @map("failed")
}

enum RunStatus {
  QUEUED        @map("queued")
  CLAIMED       @map("claimed")
  PROVISIONING  @map("provisioning")
  RUNNING       @map("running")
  WAITING_INBOX @map("waiting-inbox")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  TIMED_OUT     @map("timed-out")
  CANCELLED     @map("cancelled")
  LOST          @map("lost")
}

enum MergeRecoveryStatus {
  VALIDATING             @map("validating")
  REPAIRING              @map("repairing")
  AWAITING_AUTHORIZATION @map("awaiting-authorization")
  BLOCKED_DOWNSTREAM     @map("blocked-downstream")
  SUCCEEDED              @map("succeeded")
  FAILED                 @map("failed")
}

enum MergeRecoveryRefusalCode {
  ACTIVATION_AUTHORIZATION_STALE @map("activation-authorization-stale")
  HEAD_ADOPTION_CONFLICT         @map("head-adoption-conflict")
  PRE_INTENT                     @map("pre-intent")
  TARGET_BRANCH_MISMATCH         @map("target-branch-mismatch")
}

enum MergeLeaseEventState {
  HANDOFF_PENDING  @map("handoff-pending")
  RELEASE_DEFERRED @map("release-deferred")
  CONTENDED        @map("contended")
  RELEASED         @map("released")
  INVALID          @map("invalid")
}

enum SessionExecutionStatus {
  REQUESTED     @map("requested")
  PROVISIONING  @map("provisioning")
  RUNNING       @map("running")
  WAITING_INBOX @map("waiting-inbox")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
  TIMED_OUT     @map("timed-out")
  CANCELLED     @map("cancelled")
  LOST          @map("lost")
}

enum CleanupStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  RETAINED  @map("retained")
}

enum FailureClass {
  BINARY_NOT_FOUND       @map("binary-not-found")
  AUTH_REQUIRED          @map("auth-required")
  RATE_LIMITED           @map("rate-limited")
  CANCELLED_OR_TIMED_OUT @map("cancelled-or-timed-out")
  TOOL_FAILED            @map("tool-failed")
  TRANSIENT_PROVIDER     @map("transient-provider")
  PROTOCOL_ERROR         @map("protocol-error")
  NO_CHANGES_PRODUCED    @map("no-changes-produced")
  TASK_FAILED            @map("task-failed")
  BUDGET_EXCEEDED        @map("budget-exceeded")
}

enum SessionEventSource {
  RUNNER @map("runner")
  CLAUDE @map("claude")
  CODEX  @map("codex")
  PI     @map("pi")
}

enum PushStatus {
  NOT_REQUESTED @map("not-requested")
  PENDING       @map("pending")
  SUCCEEDED     @map("succeeded")
  FAILED        @map("failed")
}

/// The persisted operator control for a Chain. Absence of a ChainControl row
/// is also not-held; RELEASED rows are retained so their release facts and
/// hold generation remain available to later idempotency checks.
enum ChainControlState {
  HELD     @map("held")
  RELEASED @map("released")
}

model Project {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  yamlDocument       String          @default("")
  maxDurationMin     Int             @default(240)
  stallTimeoutMin    Int             @default(10)
  maxSessionsPerTask Int             @default(3)
  specGateDefault    Boolean         @default(false)
  mergeGateDefault   Boolean         @default(false)
  spendCap           Decimal?        @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  agents             Agent[]
  environments       Environment[]
  skills             Skill[]
  mcpConnections     MCPConnection[]
  repos              Repo[]
  taskTemplates      TaskTemplate[]
  tasks              Task[]
  goals              Goal[]
  runs               Run[]
  chainControls      ChainControl[]
  staffingProfiles   StaffingProfile[]
}

model Environment {
  id           String              @id @default(cuid())
  projectId    String
  name         String
  networking   NetworkingMode      @default(LIMITED)
  allowedHosts String[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents       Agent[]
  secrets      EnvironmentSecret[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
}

model Agent {
  id                                  String               @id @default(cuid())
  projectId                           String
  environmentId                       String
  name                                String
  /// The canonical identity of this Agent: the `agents/roles/<name>.md` file it
  /// was installed from, null for an operator-created Agent. `name` is a slug the
  /// operator may edit, so canonical seed, prompt sync and role binding match on
  /// this column instead.
  canonicalRole                       String?
  title                               String
  model                               String
  /// Fields the operator edited in the console. Canonical seed and prompt sync
  /// keep a listed field and adopt every unlisted one; prompts always follow
  /// canonical. Values are Agent column names: name, title, model,
  /// runnerPreference.
  customizedFields                    String[]             @default([])
  /// The customized canonical/production comparison most recently reported
  /// to Inbox. Cleared when that drift is no longer present.
  runtimeConfigDriftNoticeFingerprint String?
  codexServiceTier                    CodexServiceTier     @default(DEFAULT)
  foundationalPrompt                  String
  rolePrompt                          String
  runnerPreference                    RunnerPreference     @default(INHERIT)
  inboxAccess                         Boolean              @default(false)
  /// Denied tools, not allowed ones: empty means "every tool the CLI offers",
  /// which is what every agent had before this column existed. Keys are the eight
  /// canonical names in apps/web/src/lib/tools.ts; the runner maps them per CLI in
  /// packages/runner/src/adapters.ts.
  disabledTools                       String[]             @default([])
  createdAt                           DateTime             @default(now())
  updatedAt                           DateTime             @updatedAt
  archivedAt                          DateTime?
  project                             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment                         Environment          @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)
  skills                              AgentSkill[]
  mcpConnections                      AgentMCPConnection[]
  repoAccess                          AgentRepoAccess[]
  filesystemGrants                    FilesystemGrant[]
  collaborators                       AgentCollaboration[] @relation("AgentCollaborators")
  collaboratorFor                     AgentCollaboration[] @relation("AllowedCollaborator")
  secretGrants                        AgentSecretGrant[]
  assignedTasks                       Task[]
  templateSteps                       TaskTemplateStep[]
  staffingProfileEntries              StaffingProfileEntry[]
  sessions                            Session[]
  runs                                Run[]
  inboxMessages                       InboxMessage[]

  @@unique([projectId, name])
  @@unique([projectId, canonicalRole])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([environmentId])
}

model Skill {
  id        String       @id @default(cuid())
  projectId String
  name      String
  slug      String
  kind      SkillKind
  body      String?
  filePath  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agents    AgentSkill[]

  @@unique([projectId, slug])
  @@unique([id, projectId])
  @@index([projectId])
}

model AgentSkill {
  agentId   String
  skillId   String
  projectId String
  agent     Agent  @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  skill     Skill  @relation(fields: [skillId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, skillId])
  @@index([skillId])
}

model MCPConnection {
  id                 String               @id @default(cuid())
  projectId          String
  credentialSecretId String?
  name               String
  transport          String
  config             Json
  allowedOperations  String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialSecret   Secret?              @relation("McpCredential", fields: [credentialSecretId], references: [id], onDelete: SetNull)
  agents             AgentMCPConnection[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([credentialSecretId])
}

model AgentMCPConnection {
  agentId         String
  mcpConnectionId String
  projectId       String
  agent           Agent         @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  mcpConnection   MCPConnection @relation(fields: [mcpConnectionId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, mcpConnectionId])
  @@index([mcpConnectionId])
}

model Repo {
  id                 String            @id @default(cuid())
  projectId          String
  credentialSecretId String?
  name               String
  remoteUrl          String
  mountPath          String
  defaultBranch      String            @default("main")
  dependencyProvisioning DependencyProvisioning
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentialSecret   Secret?           @relation("RepoCredential", fields: [credentialSecretId], references: [id], onDelete: SetNull)
  agentAccess        AgentRepoAccess[]
  tasks              Task[]
  runs               Run[]
  webhookTemplates   TaskTemplate[]    @relation("WebhookRepo")

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([credentialSecretId])
}

model AgentRepoAccess {
  agentId     String
  repoId      String
  projectId   String
  mountPath   String
  permissions RepoPermission
  agent       Agent          @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  repo        Repo           @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, repoId])
  @@index([repoId])
}

// folderPath is a canonical Files-Root-relative POSIX path; "" grants the whole Files Root.
model FilesystemGrant {
  id         String  @id @default(cuid())
  agentId    String
  folderPath String
  canRead    Boolean @default(false)
  canWrite   Boolean @default(false)
  canDelete  Boolean @default(false)
  agent      Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, folderPath])
  @@index([agentId])
}

model AgentCollaboration {
  agentId        String
  allowedAgentId String
  projectId      String
  agent          Agent  @relation("AgentCollaborators", fields: [agentId, projectId], references: [id, projectId], onDelete: Cascade)
  allowedAgent   Agent  @relation("AllowedCollaborator", fields: [allowedAgentId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([agentId, allowedAgentId])
  @@index([allowedAgentId])
}

model Secret {
  id                String              @id @default(cuid())
  name              String              @unique
  encryptedValue    String
  purpose           SecretPurpose
  description       String?
  ciphertextVersion Int                 @default(1)
  keyId             String              @default("v1")
  rotatedAt         DateTime?
  disabledAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  mcpCredentials    MCPConnection[]     @relation("McpCredential")
  repoCredentials   Repo[]              @relation("RepoCredential")
  webhookTemplates  TaskTemplate[]      @relation("WebhookCredential")
  agentGrants       AgentSecretGrant[]
  environments      EnvironmentSecret[]
}

model AgentSecretGrant {
  agentId  String
  secretId String
  envVar   String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  secret   Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@id([agentId, secretId, envVar])
  @@unique([agentId, envVar])
  @@index([secretId])
}

model EnvironmentSecret {
  environmentId String
  secretId      String
  envVar        String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  secret        Secret      @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@id([environmentId, secretId, envVar])
  @@unique([environmentId, envVar])
  @@index([secretId])
}

model TaskTemplate {
  id                     String             @id @default(cuid())
  projectId              String
  name                   String
  description            String
  variables              String[]
  webhookSecretId        String?
  webhookRepoId          String?
  webhookPayloadMapping  Json?
  webhookPausedAt        DateTime?
  webhookReplayWindowSec Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  project                Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webhookSecret          Secret?            @relation("WebhookCredential", fields: [webhookSecretId], references: [id], onDelete: SetNull)
  webhookRepo            Repo?              @relation("WebhookRepo", fields: [webhookRepoId], references: [id], onDelete: Restrict)
  steps                  TaskTemplateStep[]
  tasks                  Task[]
  fires                  TriggerFire[]
  staffingProfiles       StaffingProfile[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([webhookSecretId])
  @@index([webhookRepoId])
}

model TaskTemplateStep {
  id                      String       @id @default(cuid())
  taskTemplateId          String
  assigneeAgentId         String?
  stepIndex               Int
  name                    String
  assigneeType            AssigneeType
  prompt                  String
  approvalGate            Boolean      @default(false)
  optional                Boolean      @default(false)
  attachmentsFromPrevious Boolean      @default(false)
  priorOutputKinds        String[]     @default([])
  spawnPolicy             Json?
  runner                  RunnerKind?
  outputKind              String       @default("result")
  opensPullRequest        Boolean      @default(true)
  /// Whether a successful Run must advance the workspace commit. False still
  /// publishes the branch, because a later Chain Step may need to clone it.
  requiresCommit          Boolean      @default(true)
  provisionDependencies   Boolean      @default(true)
  baseFromStepIndex       Int?
  layer                   Int
  taskTemplate            TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  assigneeAgent           Agent?       @relation(fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  tasks                   Task[]

  @@unique([taskTemplateId, stepIndex])
  @@index([assigneeAgentId])
}

/// One named staffing plan for one TaskTemplate: who runs each step and which
/// optional steps a chain instantiated from it keeps. Profiles hang off the
/// template rather than the project so a project may keep several plans for
/// the same graph; exactly one of a template's profiles is its default, and
/// instantiation falls back to the canonical step bindings when a template has
/// no profile at all.
model StaffingProfile {
  id             String                 @id @default(cuid())
  projectId      String
  taskTemplateId String
  name           String
  isDefault      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskTemplate   TaskTemplate           @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  entries        StaffingProfileEntry[]

  @@unique([taskTemplateId, name])
  @@index([projectId])
  @@index([taskTemplateId])
}

/// One profile opinion about one template step, keyed by the step's exact
/// `outputKind`. Authoring already forbids duplicate output kinds inside a
/// graph, so the kind identifies the step without depending on its index, and
/// `foo` and `foo-v2` are deliberately distinct keys. `include` is meaningful
/// only for steps the template marks optional; it is null everywhere else.
/// The Agent reference is `Restrict` on purpose: dropping an operator's
/// staffing decision because an Agent row disappeared would be a silent
/// fallback to the canonical assignee.
model StaffingProfileEntry {
  profileId       String
  outputKind      String
  assigneeAgentId String?
  include         Boolean?
  profile         StaffingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assigneeAgent   Agent?          @relation(fields: [assigneeAgentId], references: [id], onDelete: Restrict)

  @@id([profileId, outputKind])
  @@index([assigneeAgentId])
}

model Task {
  id                       String                 @id @default(cuid())
  projectId                String
  assigneeAgentId          String?
  repoId                   String?
  templateId               String?
  templateStepId           String?
  name                     String
  description              String
  workingDirectory         String?
  targetBranch             String?
  failureReason            String?
  readinessClaimToken      String?
  readinessClaimExpiresAt  DateTime?
  status                   TaskStatus             @default(TODO)
  source                   TaskSource             @default(MANUAL)
  archivedAt               DateTime?
  schedulePausedAt         DateTime?
  recurringSourceTaskId    String?
  assigneeType             AssigneeType           @default(AGENT)
  approvalGate             Boolean                @default(false)
  /// Whether a run of this task may open a pull request. Copied onto each Run at
  /// creation so a PATCH cannot change a run that is already queued.
  opensPullRequest         Boolean                @default(true)
  chainId                  String?
  chainIndex               Int?
  chainLayer               Int?
  scheduleKind             ScheduleKind           @default(NOW)
  runAt                    DateTime?
  cron                     String?
  timezone                 String?
  maxDurationMin           Int                    @default(240)
  stallTimeoutMin          Int                    @default(10)
  maxSessionsPerTask       Int                    @default(5)
  spendCap                 Decimal?               @db.Decimal(12, 2)
  spendCapApplicable       Boolean                @default(false)
  /// Goal 5a0 lineage. All eleven columns are all-null on a manual/chain/template/
  /// CRON/AT Task and all-non-null-where-required on a Goal-linked Task; the
  /// database checks installed by 20260818000000_goal_execution_safety_kernel are
  /// the backstop, and only the Goal safety kernel writes them.
  goalId                   String?
  goalGeneration           Int?
  goalIteration            Int?
  goalDispatchKey          String?
  goalDispatchRequestHash  String?
  goalDispatchState        GoalDispatchState?
  goalDecisionKey          String?
  goalDecisionRequestHash  String?
  goalDecisionRunId        String?
  goalDecisionAt           DateTime?
  goalPredecessorTaskId    String?                @unique
  dispatchAfterTaskId      String?                @unique
  createdAt                DateTime               @default(now())
  /// Stable completion clock for age-based retention. A database trigger sets
  /// it on every transition into DONE and clears it on every transition out.
  doneAt                   DateTime?
  updatedAt                DateTime               @updatedAt
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeAgent            Agent?                 @relation(fields: [assigneeAgentId, projectId], references: [id, projectId], onDelete: Restrict)
  repo                     Repo?                  @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Restrict)
  template                 TaskTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateStep             TaskTemplateStep?      @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  recurringSource          Task?                  @relation("TaskRecurringSource", fields: [recurringSourceTaskId], references: [id], onDelete: SetNull)
  recurringCopies          Task[]                 @relation("TaskRecurringSource")
  activity                 TaskActivity[]
  sessions                 Session[]
  runs                     Run[]
  inboxMessages            InboxMessage[]
  gateMessages             InboxMessage[]         @relation("InboxGateTask")
  inboxThreads             InboxThread[]
  stepOutput               TaskStepOutput?
  goal                     Goal?                  @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  goalDecisionRun          Run?                   @relation("TaskGoalDecisionRun", fields: [goalDecisionRunId], references: [id], onDelete: Restrict)
  goalPredecessorTask      Task?                  @relation("TaskGoalPredecessor", fields: [goalPredecessorTaskId], references: [id], onDelete: Restrict)
  goalSuccessorTask        Task?                  @relation("TaskGoalPredecessor")
  dispatchAfter            Task?                  @relation("TaskDispatchBinding", fields: [dispatchAfterTaskId, projectId], references: [id, projectId], onDelete: Restrict)
  dispatchedChainFirstTask Task?                  @relation("TaskDispatchBinding")
  /// Step 2.7 identity backstops. The single-column relations stay as the
  /// delete restrictions the spec names; these composite ones are what stop a
  /// predecessor, Run, or event from crossing a Goal, generation, or iteration.
  goalPredecessorIdentity  Task?                  @relation("TaskGoalPredecessorIdentity", fields: [goalPredecessorTaskId, goalId, goalGeneration], references: [id, goalId, goalGeneration], onDelete: Restrict)
  goalSuccessorIdentities  Task[]                 @relation("TaskGoalPredecessorIdentity")
  goalLineageRuns          Run[]                  @relation("RunGoalLineageIdentity")
  goalEventIdentities      GoalExecutionEvent[]   @relation("GoalEventTaskIdentity")
  goalExecutionEvents      GoalExecutionEvent[]
  mergeRecoveryAttempts    MergeRecoveryAttempt[]
  gateAttestations         MergeGateAttestation[]
  ownedMergeLeaseEvents    MergeLeaseEvent[]      @relation("MergeLeaseOwningTask")

  @@unique([chainId, chainIndex])
  @@unique([id, projectId])
  @@unique([goalId, goalGeneration, goalIteration])
  @@unique([goalId, goalDispatchKey])
  @@unique([goalId, goalDecisionKey])
  @@unique([id, goalId, goalGeneration])
  @@unique([id, goalId, goalGeneration, goalIteration])
  @@unique([dispatchAfterTaskId, projectId])
  @@index([projectId, status])
  @@index([assigneeAgentId])
  @@index([templateId])
  @@index([templateStepId])
  @@index([repoId])
  @@index([scheduleKind, status, runAt])
  @@index([projectId, archivedAt, status])
  @@index([status, archivedAt, doneAt, id])
  @@index([recurringSourceTaskId])
  @@index([goalId, goalDispatchState])
  @@index([goalPredecessorTaskId])
}

/// One persisted authority for the operator hold state of a project/Chain
/// pair. `chainId` is unique within a project by convention, so it is scoped
/// with `projectId` exactly like the existing Chain readers. A released row
/// keeps the last hold facts and release facts; a missing row is the initial
/// not-held state.
model ChainControl {
  id               String              @id @default(cuid())
  projectId        String
  chainId          String
  state            ChainControlState   @default(HELD)
  heldLayer        Int?
  /// Stored Task.chainLayer/chainIndex boundary. Null distinguishes a
  /// before-first hold from a real stored layer zero.
  heldExecutionLayer Int?
  heldAt           DateTime?
  holdRequestId    String?
  holdReason       String?
  releasedAt       DateTime?
  releaseRequestId String?
  holdGeneration   Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events           ChainControlEvent[]

  @@unique([projectId, chainId])
  @@index([projectId, state])
}

/// Append-only audit history for accepted Chain control transitions. The
/// uniqueness key deliberately includes the transition kind: a request id is
/// allowed once for Hold and once for Resume, but never twice for either kind,
/// even after the mutable ChainControl row has moved on to the opposite state.
model ChainControlEvent {
  id             String            @id @default(cuid())
  chainControlId String
  kind           ChainControlState
  layer          Int
  actorType      String
  actorId        String?
  requestId      String
  reason         String?
  createdAt      DateTime          @default(now())
  holdGeneration Int
  chainControl   ChainControl      @relation(fields: [chainControlId], references: [id], onDelete: Cascade)

  @@unique([chainControlId, kind, requestId])
  @@index([chainControlId, createdAt])
}

/// Canonical authority for one automatic pre-merge base-drift recovery.
/// TaskActivity and Inbox rows derived from this record are audit and
/// notification projections only; they are never read back as authority.
model MergeRecoveryAttempt {
  id                      String                    @id @default(cuid())
  integratorTaskId        String
  sourceStopId            String
  attempt                 Int
  status                  MergeRecoveryStatus       @default(VALIDATING)
  validationAttempts      Int                       @default(0)
  boundSourceRunId        String?
  authorizationActivityId String?
  recoveryRunId           String?
  readinessTaskId         String?
  regressionTaskId        String?
  repository              String?
  prNumber                Int?
  targetBranch            String?
  authorizedHeadSha       String?
  authorizedBaseSha       String?
  observedBaseSha         String?
  currentBaseSha          String?
  failureReason           String?
  refusalCode             MergeRecoveryRefusalCode?
  startedAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  endedAt                 DateTime?
  integratorTask          Task                      @relation(fields: [integratorTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceStopId, attempt])
  @@index([integratorTaskId, status])
  @@index([status, refusalCode, updatedAt])
  @@index([recoveryRunId])
  @@index([repository, prNumber, targetBranch])
}

/// Append-only ledger of trigger fires. Nothing reads it but the Triggers UI,
/// and the replay-window lookup keys off (templateId, dedupeKey, createdAt).
model TriggerFire {
  id         String            @id @default(cuid())
  templateId String
  chainId    String?
  source     TriggerFireSource
  dedupeKey  String?
  createdAt  DateTime          @default(now())
  template   TaskTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([templateId, dedupeKey, createdAt])
}

model TaskStepOutput {
  id        String   @id @default(cuid())
  taskId    String   @unique
  runId     String?
  kind      String
  body      String
  metadata  Json?
  commitSha String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([runId])
}

/// One merge gate verdict, bound to the commit the gate signed.
///
/// `scripts/merge-gate.sh` prints `MERGE GATE: PASS <oid>`, and a Regression
/// verification run copies that line verbatim into its output. Ingestion writes
/// the line here in the same fenced transaction that persists the output, so the
/// attestation and the evidence it was derived from can never disagree.
///
/// Both merge authorization channels read this table. Before it existed the
/// Inbox and PATCH channels built an authorization from the card body alone and
/// never saw a gate verdict at all, so a human approval could authorize a head
/// no gate had signed. `(chainId, headSha)` is unique because an attestation is
/// a statement about a commit, not about the run that reported it.
model MergeGateAttestation {
  id          String   @id @default(cuid())
  chainId     String
  taskId      String
  runId       String?
  headSha     String
  baseHeadSha String
  proof       String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run         Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([chainId, headSha])
  @@index([taskId])
  @@index([runId])
}

/// Durable authority for one merge Lease event. TaskActivity rows are derived
/// operator projections; reconciliation reads this ledger instead of parsing
/// their metadata.
model MergeLeaseEvent {
  id             String               @id @default(cuid())
  projectId      String
  chainId        String
  leaseRef       String?
  leaseSha       String?
  state          MergeLeaseEventState
  owningTaskId   String
  handedOffRunId String?
  handedOffAt    DateTime?
  deferredAt     DateTime?
  settledAt      DateTime?
  acquiredAt     DateTime?
  failureDetail  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  owningTask     Task                 @relation("MergeLeaseOwningTask", fields: [owningTaskId], references: [id], onDelete: Cascade)
  handedOffRun   Run?                 @relation("MergeLeaseHandoffRun", fields: [handedOffRunId], references: [id], onDelete: Restrict)

  @@unique([projectId, chainId, leaseSha])
  @@unique([projectId, chainId, handedOffRunId])
  @@index([state, handedOffAt, id])
  @@index([state, deferredAt, id])
  @@index([owningTaskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorType String
  actorId   String?
  body      String
  metadata  Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Goal {
