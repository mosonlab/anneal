model GoalProgressEntry {
  id        String   @id @default(cuid())
  goalId    String
  sessionId String?
  body      String
  metadata  Json?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@index([sessionId])
}

model Run {
  id                            String                 @id @default(cuid())
  projectId                     String
  taskId                        String?
  goalId                        String?
  goalGeneration                Int?
  goalIteration                 Int?
  /// The immediate source Run this Run retries. Null on a first Run. Unique, so a
  /// source Run can have at most one retry child — the database backstop behind
  /// the kernel's single-flight retry.
  retryOfRunId                  String?                @unique
  agentId                       String
  repoId                        String?
  blockedByRunId                String?
  runNumber                     Int
  dedupeKey                     String                 @unique
  status                        RunStatus              @default(QUEUED)
  readyAt                       DateTime               @default(now())
  runner                        RunnerKind
  runnerId                      String?
  leaseGeneration               Int                    @default(0)
  fencingToken                  String?                @unique
  leaseExpiresAt                DateTime?
  heartbeatAt                   DateTime?
  lastProcessAliveAt            DateTime?
  lastProgressEventAt           DateTime?
  inFlightTool                  Json?
  sessionTokenHash              String?                @unique
  sessionTokenExpiresAt         DateTime?
  sessionTokenRevokedAt         DateTime?
  /// Operator cancellation is a durable intent before it is a terminal state.
  /// The owning runner observes this through heartbeat, kills its provider
  /// process group, then acknowledges the same request id. While intent is
  /// present every ordinary lease-authorized write is fenced out.
  cancelRequestId               String?                @unique
  cancelReason                  String?
  cancelRequestedAt             DateTime?
  cancelAcknowledgedAt          DateTime?
  workspacePath                 String?
  workspaceRetained             Boolean                @default(false)
  /// Control-plane *intent*, not an action: "the runner that owns this run's
  /// workspace root may reclaim its directory". The API publishes it and never
  /// deletes anything itself (issue #115); disposal belongs to the runner,
  /// which is the only process that owns the root it provisioned into.
  workspaceReclaimAt            DateTime?
  /// Set when the owning runner reports back what it did with the intent —
  /// removed or refused. A closed intent is never re-offered, and no later
  /// report may reopen it or change what it settled on.
  workspaceReclaimedAt          DateTime?
  /// Reclaim attempts that failed. It is what lets a failure report take the
  /// same compare-and-set as a closing one — a `FAILED` that arrives after the
  /// intent closed must not roll a succeeded cleanup back — and it is what an
  /// operator reads to find a workspace nobody can remove.
  workspaceReclaimAttempts      Int                    @default(0)
  /// Report-only observation from terminal completion. Each entry is an
  /// absolute worktree path registered by this Run's checkout that was found
  /// outside the Run workspace. NULL means the runner reported no observation
  /// (including an omitted or empty completion field); it never changes the
  /// Run's outcome.
  worktreeContainmentViolations Json?
  /// The PR decision snapshotted when this run was created, so an operator's
  /// PATCH of the task cannot change a run already queued. The runner reads this
  /// and never the live task row.
  opensPullRequest              Boolean                @default(true)
  /// Immutable delivery contract copied from the template Step at Run birth.
  /// For manual Tasks, Run birth derives this from the snapshotted
  /// pull-request decision.
  requiresCommit                Boolean                @default(true)
  targetBranch                  String?
  branch                        String?
  /// The ref this run actually handed to `git push`, written only after the push
  /// returned. It is not the derived chain branch — `sharedChainBranch` remains
  /// the only thing that computes that — it is the record of what was published,
  /// and it is the only signal `resolveRunBranches` trusts as evidence that a
  /// chain branch exists on a remote. `branch` and `pushStatus` cannot answer
  /// that question: see the comment in workflow.ts.
  pushedBranch                  String?
  baseSha                       String?
  headSha                       String?
  /// The first parent of the WIP salvage commit a failed Run pushed, written
  /// only on the salvage path. With `headSha` — the salvage commit itself — it
  /// is what the next Run of the task is told, so an agent that starts on a
  /// salvaged head can tell whether that salvage sits directly on the head it
  /// was supposed to work from without reading git history.
  salvageParentSha              String?
  pushStatus                    PushStatus             @default(NOT_REQUESTED)
  pushRemote                    String?
  pushError                     String?
  pullRequestUrl                String?
  pullRequestNumber             Int?
  deliveryInstructions          String?
  adapterVersion                String?
  cliVersion                    String?
  model                         String
  /// Immutable launch snapshot. DEFAULT is explicit rather than an omitted
  /// provider value, so Anneal never delegates this choice to `auto`.
  codexServiceTier              CodexServiceTier       @default(DEFAULT)
  /// Immutable native-child capability snapshot. Null outside Codex
  /// implementation steps; fixed by the platform rather than Agent setup.
  subagentModel                 String?
  subagentMaxConcurrent         Int?
  authMode                      String?
  manifest                      Json?
  /// SHA-256 of the exact prompt bytes most recently dispatched for this Run.
  /// Null before the first successful runner start write.
  promptHash                    String?
  maxDurationMin                Int                    @default(240)
  stallTimeoutMin               Int                    @default(10)
  maxRunsPerTask                Int                    @default(5)
  // How many extra attempts this task has been *granted* on top of whatever
  // `Task.maxSessionsPerTask` says right now: one per attempt refunded as an
  // external failure, plus any a human re-authorized. `maxRunsPerTask` is the
  // absolute ceiling that answer produced, and it cannot be read back apart
  // from the configured budget of the moment it was written — which is why
  // lowering a task's budget used to leave the old, higher number in force.
  // Carried forward onto every run a task creates, so the newest row is the
  // running total.
  budgetGrants                  Int                    @default(0)
  spendCap                      Decimal?               @db.Decimal(12, 2)
  spendCapApplicable            Boolean                @default(false)
  failureClass                  FailureClass?
  failureReason                 String?
  retryable                     Boolean?
  retryAt                       DateTime?
  terminationReason             String?
  /// The structured account the runner gave of this failure: phase, exit facts,
  /// channel-separated evidence and typed timeout/transient markers. The API
  /// classifies from this and stores it verbatim, so a disputed verdict can be
  /// re-decided against what was actually observed instead of re-run. A
  /// definitive mechanical result may settle protocol success while retaining
  /// a later failed completion envelope as diagnostics. See
  /// packages/db/src/failure-envelope.ts.
  failureEnvelope               Json?
  /// The raw tail of what this run produced: the agent's final output when it
  /// emitted one, otherwise the run's stdout, capped at 500k by the runner that
  /// sent it. Written on every completion a runner reports, succeeded or
  /// failed. Before this column the tail survived only when a *successful* run
  /// belonged to a template, chain or follow-up task, so the evidence of a
  /// failure — the case where it is worth the most — was discarded by the API
  /// that received it.
  ///
  /// Run telemetry, not a deliverable: it is never read into a downstream
  /// prompt, and it carries no "which run's output counts" semantics. That
  /// question belongs to TaskStepOutput (issue #121). Kept out of the run rows
  /// the task read routes serialize, because a task's five tails would dwarf
  /// everything else in the response.
  output                        String?
  queuedAt                      DateTime               @default(now())
  claimedAt                     DateTime?
  startedAt                     DateTime?
  endedAt                       DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  project                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                          Task?                  @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  goal                          Goal?                  @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  agent                         Agent                  @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Restrict)
  repo                          Repo?                  @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Restrict)
  blockedBy                     Run?                   @relation("RunDependency", fields: [blockedByRunId], references: [id], onDelete: SetNull)
  dependents                    Run[]                  @relation("RunDependency")
  session                       Session?
  events                        SessionEvent[]
  inboxDecisions                InboxDecision[]
  stepOutputs                   TaskStepOutput[]
  retryOfRun                    Run?                   @relation("RunRetryParent", fields: [retryOfRunId], references: [id], onDelete: Restrict)
  retryChildRun                 Run?                   @relation("RunRetryParent")
  goalDecisionTasks             Task[]                 @relation("TaskGoalDecisionRun")
  goalLineageTask               Task?                  @relation("RunGoalLineageIdentity", fields: [taskId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)
  goalEventIdentities           GoalExecutionEvent[]   @relation("GoalEventRunIdentity")
  goalExecutionEvents           GoalExecutionEvent[]
  gateAttestations              MergeGateAttestation[]
  handedOffLeaseEvents          MergeLeaseEvent[]      @relation("MergeLeaseHandoffRun")

  @@unique([taskId, runNumber])
  @@unique([id, projectId])
  @@unique([id, goalId, goalGeneration, goalIteration])
  @@index([status, readyAt])
  @@index([status, leaseExpiresAt])
  @@index([projectId])
  @@index([agentId])
  @@index([repoId])
  @@index([blockedByRunId])
  @@index([goalId, goalGeneration, goalIteration])
  @@index([retryOfRunId])
}

model Session {
  id                     String                 @id @default(cuid())
  runId                  String                 @unique
  projectId              String
  agentId                String
  taskId                 String?
  goalId                 String?
  runner                 RunnerKind
  executionStatus        SessionExecutionStatus @default(REQUESTED)
  cleanupStatus          CleanupStatus          @default(PENDING)
  runtimeHandle          String?
  providerConversationId String?
  waitingOnMessageId     String?
  resumableUntil         DateTime?
  resumeAttempt          Int                    @default(0)
  resumeInput            String?
  maxDurationMin         Int                    @default(240)
  stallTimeoutMin        Int                    @default(10)
  requestedAt            DateTime               @default(now())
  provisionedAt          DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
  cleanupStartedAt       DateTime?
  cleanupEndedAt         DateTime?
  exitCode               Int?
  signal                 String?
  terminationReason      String?
  /// Provider-captured authoritative amount in USD. NULL means that no
  /// authoritative amount was captured; it never means zero or an estimate.
  costUsd                Decimal?               @db.Decimal(12, 4)
  /// All provider-reported input tokens, including cached input tokens.
  inputTokens            Int?
  /// Provider-reported output tokens. Reasoning is included only when the
  /// provider includes it in its output figure.
  outputTokens           Int?
  /// The cached-input subset of inputTokens. It is informational and must not
  /// be added to inputTokens again when computing totalTokens. When
  /// cacheCreationInputTokens is non-NULL this column is cache reads only;
  /// while it is NULL, a legacy row may still contain reads plus writes.
  cachedInputTokens      Int?
  /// Input tokens written to a provider cache. NULL means the provider did not
  /// report a cache read/write split; it is never an observed zero.
  cacheCreationInputTokens Int?
  /// True only after the runner observes a successful native child spawn.
  /// Run.subagentModel is launch capability, not evidence that a child ran.
  nativeChildUsed        Boolean                @default(false)
  /// inputTokens + outputTokens. Cached input is counted once because it is
  /// already included in inputTokens.
  totalTokens            Int?
  failureReason          String?
  cleanupFailureReason   String?
  run                    Run                    @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Cascade)
  agent                  Agent                  @relation(fields: [agentId, projectId], references: [id, projectId], onDelete: Restrict)
  task                   Task?                  @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  goal                   Goal?                  @relation(fields: [goalId, projectId], references: [id, projectId], onDelete: Restrict)
  events                 SessionEvent[]
  inboxMessages          InboxMessage[]
  inboxThreads           InboxThread[]
  progressEntries        GoalProgressEntry[]

  @@unique([runId, projectId])
  @@index([executionStatus, requestedAt])
  @@index([cleanupStatus, requestedAt])
  @@index([projectId, requestedAt])
  @@index([agentId])
  @@index([taskId])
  @@index([goalId])
}

model SessionEvent {
  id              String             @id @default(cuid())
  sessionId       String
  runId           String
  seq             Int
  at              DateTime           @default(now())
  source          SessionEventSource
  type            String
  providerEventId String?
  toolCallId      String?
  payload         Json
  session         Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run             Run                @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([runId, at])
  @@index([runId, seq])
  @@index([sessionId, at])
}

model RunnerBackendState {
  runner                  RunnerKind @id
  cliVersion              String?
  authMode                String?
  capabilities            Json?
  lastPreflightAt         DateTime?
  lastPreflightOk         Boolean    @default(false)
  consecutiveAuthFailures Int        @default(0)
  circuitOpen             Boolean    @default(false)
  circuitReason           String?
  circuitOpenedAt         DateTime?
  updatedAt               DateTime   @updatedAt
}

model InboxMessage {
  id                String              @id @default(cuid())
  from              InboxSender
  agentId           String?
  sessionId         String?
  taskId            String?
  goalId            String?
  gateTaskId        String?
  threadId          String?
  replyToMessageId  String?
  kind              InboxKind           @default(TEXT)
  body              String
  choices           Json?
  selectedChoiceId  String?
  status            InboxStatus         @default(OPEN)
  channel           InboxChannel        @default(FEISHU)
  dedupeKey         String?             @unique
  externalMessageId String?             @unique
  externalActionId  String?             @unique
  deliveryStatus    InboxDeliveryStatus @default(PENDING)
  deliveryAttempts  Int                 @default(0)
  nextDeliveryAt    DateTime            @default(now())
  deliveredAt       DateTime?
  lastDeliveryError String?
  createdAt         DateTime            @default(now())
  answeredAt        DateTime?
  agent             Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  session           Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task              Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal              Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  gateTask          Task?               @relation("InboxGateTask", fields: [gateTaskId], references: [id], onDelete: SetNull)
  thread            InboxThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  replyTo           InboxMessage?       @relation("InboxReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           InboxMessage[]      @relation("InboxReplies")
  decisions         InboxDecision[]

  @@index([status, createdAt])
  @@index([agentId])
  @@index([sessionId])
  @@index([taskId])
  @@index([goalId])
  @@index([gateTaskId, status])
  @@index([threadId, status, createdAt])
  @@index([deliveryStatus, nextDeliveryAt])
}

model InboxThread {
  id             String         @id @default(cuid())
  channel        InboxChannel   @default(FEISHU)
  externalChatId String
  sessionId      String?
  taskId         String?
  goalId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  messages       InboxMessage[]

  @@unique([channel, externalChatId, sessionId])
  @@index([externalChatId])
  @@index([sessionId])
}

model InboxExternalEvent {
  id              String       @id @default(cuid())
  channel         InboxChannel @default(FEISHU)
  externalEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime     @default(now())
  processedAt     DateTime?
  processingError String?

  @@unique([channel, externalEventId])
  @@index([processedAt, receivedAt])
}

model InboxDecision {
  id              String       @id @default(cuid())
  inboxMessageId  String
  runId           String
  externalEventId String       @unique
  decision        String
  actorOpenId     String?
  createdAt       DateTime     @default(now())
  inboxMessage    InboxMessage @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)
  run             Run          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([inboxMessageId])
  @@index([runId])
}

/// Durable, append-only evidence of every Goal execution transition. One row per
/// committed non-no-op transition, except restart, which writes exactly two.
model GoalExecutionEvent {
  id             String   @id @default(cuid())
  goalId         String
  goalGeneration Int
  goalIteration  Int?
  taskId         String?
  runId          String?
  type           String
  dedupeKey      String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Restrict)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  run            Run?     @relation(fields: [runId], references: [id], onDelete: Restrict)
  taskIdentity   Task?    @relation("GoalEventTaskIdentity", fields: [taskId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)
  runIdentity    Run?     @relation("GoalEventRunIdentity", fields: [runId, goalId, goalGeneration, goalIteration], references: [id, goalId, goalGeneration, goalIteration], onDelete: Restrict)

  @@index([goalId, createdAt])
  @@index([goalId, goalGeneration, goalIteration])
  @@index([taskId])
  @@index([runId])
}
